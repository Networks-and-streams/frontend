# Backend API base URL. Leave unset for the local development setup
# (Vite proxy / infra Nginx route relative /api/... to the backend, and the
# whole app is exposed through one public ngrok origin).
# Only set this to point the app at an already-deployed backend, e.g.:
# VITE_API_URL='https://api.example.com'

# Google Pay configuration (optional during development).
# Environment: TEST or PRODUCTION.
VITE_GOOGLE_PAY_ENV='TEST'
# Merchant ID used in PRODUCTION. Optional in TEST.
# VITE_GOOGLE_PAY_MERCHANT_ID=''