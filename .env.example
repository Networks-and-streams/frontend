# Backend API base URL. Leave unset for the local development setup
# (Vite proxy / infra Nginx route relative /api/... to the backend, and the
# whole app is exposed through one public ngrok origin).
# Only set this to point the app at an already-deployed backend, e.g.:
# VITE_API_URL='https://api.example.com'

# Google Pay configuration.
# Environment: TEST or PRODUCTION. Must match the Stripe key mode below.
VITE_GOOGLE_PAY_ENV='TEST'
# Google merchant ID. Optional in TEST; required in PRODUCTION (public value).
VITE_GOOGLE_PAY_MERCHANT_ID=''
# Stripe publishable key (public, pk_test_...). Required for Google Pay's Stripe
# gateway tokenization. The matching secret key lives on the backend only.
VITE_STRIPE_PUBLISHABLE_KEY=''
