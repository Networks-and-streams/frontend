{
	"name": "graph-resolver-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"init": "npm install && npm run build",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"preview": "vite preview",
		"dev:e2e": "vite --port 5199 --strictPort",
		"test:e2e": "playwright test",
		"typecheck:e2e": "tsc -p tsconfig.e2e.json"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.2",
		"axios": "^1.18.1",
		"cytoscape": "^3.34.3",
		"cytoscape-elk": "^2.3.0",
		"elkjs": "^0.12.0",
		"i18next": "^26.4.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-i18next": "^17.0.15",
		"react-router-dom": "^7.13.0",
		"tailwindcss": "^4.3.2",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.65.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/cytoscape": "^3.21.9",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react-swc": "^4.2.2",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"jsdom": "^29.1.1",
		"pg": "^8.23.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.48.0",
		"vite": "^7.3.1",
		"vitest": "^5.1.0"
	}
